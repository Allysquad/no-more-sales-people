{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Validate Docker web service",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"--build",
				"-d",
				"web"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Prisma client",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"db:generate"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run ESLint",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Next.js application",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run end-to-end tests",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"test:e2e"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check working tree",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}