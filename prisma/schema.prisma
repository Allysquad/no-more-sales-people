generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  postcode  String
  notes     String   @default("")
  responses Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model BusinessUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}