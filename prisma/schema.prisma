generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadPlanType {
  ONE_COUNTRY
  MULTIPLE_COUNTRIES
  ALL_COUNTRIES
}

enum LeadCountry {
  SCOTLAND
  IRELAND
  ENGLAND
  WALES
}

enum LeadRating {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  postcode  String
  notes     String   @default("")
  responses Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model BusinessUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  leadPlanId String
  leadPlan  LeadPlan @relation(fields: [leadPlanId], references: [id])
  subscriptions LeadSubscription[]
  createdAt DateTime @default(now())
}

model LeadPlan {
  id                 String         @id @default(cuid())
  name               String
  type               LeadPlanType
  countries          LeadCountry[]
  ratings            LeadRating[]
  monthlyPricePence  Int
  pricePerLeadPence  Int
  users              BusinessUser[]
  createdAt          DateTime       @default(now())
}

model LeadSubscription {
  id                 String         @id @default(cuid())
  businessUserId     String
  businessUser       BusinessUser  @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  type               LeadPlanType
  countries          LeadCountry[]
  rating             LeadRating
  monthlyPricePence  Int
  acceptedAt         DateTime
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())

  @@index([businessUserId, active])
}